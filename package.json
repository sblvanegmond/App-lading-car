{
  "name": "laadmoment",
  "version": "1.0.0",
  "description": "Twee telefoonapps: Laadmoment berekent de beste laadmomenten voor je auto, Coach is een leefstijlcoach met Claude, Strava en Garmin.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:sync": "python3 -m unittest discover -s coach/sync",
    "icons": "node tools/make-icons.js",
    "prestart": "node tools/make-icons.js && node coach/tools/build-sdk.js",
    "start": "node tools/serve.js",
    "build": "node tools/make-icons.js && node coach/tools/build-sdk.js",
    "vapid": "node tools/generate-vapid.js",
    "notify": "node tools/notify.js --dry-run",
    "coach:sdk": "node coach/tools/build-sdk.js",
    "coach:strava-login": "node coach/tools/strava-login.js",
    "coach:garmin-login": "python3 coach/tools/garmin_login.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "esbuild": "0.25.10"
  }
}
