    <path
        android:strokeColor="#FBBF24"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M70,20 L70,24 M70,48 L70,52 M54,36 L58,36 M82,36 L86,36 M58.7,24.7 L61.5,27.5 M78.5,44.5 L81.3,47.3 M58.7,47.3 L61.5,44.5 M78.5,27.5 L81.3,24.7" />
