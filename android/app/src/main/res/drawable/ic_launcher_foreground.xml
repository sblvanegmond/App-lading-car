    <path
        android:fillColor="#FBBF24"
        android:pathData="M70,36 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
    <!-- bolt, with a dark outline so it stands free of the sun -->
    <path
        android:fillColor="#34D399"
        android:strokeColor="#0F1115"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M54,24 L34,60 L49,60 L44,84 L72,46 L57,46 L63,24 Z" />
